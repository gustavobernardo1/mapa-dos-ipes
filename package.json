{
  "name": "mapa-dos-ipes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "\u003e=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-map-worker.mjs",
    "map:icons": "node scripts/prepare-botanical-icons.mjs",
    "map:measure": "node scripts/map-performance-review.mjs --production",
    "dev": "next dev --hostname 127.0.0.1",
    "format": "prettier --write src tests scripts docs research *.ts *.mjs *.json",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint \u0026\u0026 npm run typecheck \u0026\u0026 npm test \u0026\u0026 npm run build",
    "infra:status": "node scripts/infra-status.mjs",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:test": "node scripts/database.mjs test",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "test:supabase": "node scripts/supabase-flow.mjs",
    "import:prefeitura:prepare": "node scripts/importacao/prefeitura-goiania.mjs --prepare",
    "import:prefeitura:plan": "node scripts/importacao/prefeitura-goiania.mjs --plan",
    "import:prefeitura:apply": "node scripts/importacao/prefeitura-goiania.mjs --apply"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "exifr": "^7.1.3",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^6.11.2",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/geojson": "^7946.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "libpg-query": "^18.1.5",
    "pg": "^8.23.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  }
}
